+++ b/firmware/main/launcher.c
@@ -3,7 +3,9 @@
 #include "nand_storage.h"
 #include "bsp/esp_mosaico.h"
 #include "freertos/queue.h"
+#include "esp_log.h"
 #include "esp_spiffs.h"
