--- a/adapter/src/adapter/esp_lv_adapter.c
+++ b/adapter/src/adapter/esp_lv_adapter.c
@@ -23,6 +23,7 @@
 #include "esp_heap_caps.h"
 #include "lvgl.h"
 #include "esp_lv_adapter.h"
+#include "esp_lv_adapter_koi.h"
 #include "adapter_internal.h"
 #include "display_manager.h"
 #include "display_bridge.h"
@@ -33,6 +34,69 @@
 
 /* Global adapter context */
 static esp_lv_adapter_context_t s_ctx;
+
+static bool s_koi_mode;
+static portMUX_TYPE s_koi_stats_lock = portMUX_INITIALIZER_UNLOCKED;
+static koi_panel_stats_t s_koi_stats;
+static int64_t s_koi_since_us, s_koi_previous_frame_us;
+static unsigned s_koi_window_frames;
+
+void koi_panel_set_mode(bool enabled)
+{
+    s_koi_mode = enabled;
+    if (!enabled) return;
+    portENTER_CRITICAL(&s_koi_stats_lock);
+    s_koi_stats = (koi_panel_stats_t){0};
+    s_koi_since_us = esp_timer_get_time();
+    s_koi_previous_frame_us = 0;
+    s_koi_window_frames = 0;
+    portEXIT_CRITICAL(&s_koi_stats_lock);
+}
+
+bool koi_panel_mode(void) { return s_koi_mode; }
+
+void koi_panel_wake(void)
+{
+    if (s_ctx.task) xTaskNotifyGive(s_ctx.task);
+}
+
+void koi_panel_snapshot(koi_panel_stats_t *out)
+{
+    portENTER_CRITICAL(&s_koi_stats_lock);
+    *out = s_koi_stats;
+    portEXIT_CRITICAL(&s_koi_stats_lock);
+}
+
+void koi_panel_record(bool last, bool shared, bool extra_wait, bool timeout,
+                      uint32_t period, uint32_t wait, uint32_t dma)
+{
+    const int64_t now = esp_timer_get_time();
+    portENTER_CRITICAL(&s_koi_stats_lock);
+    s_koi_stats.areas++;
+    s_koi_stats.shared += shared;
+    s_koi_stats.extra_waits += extra_wait;
+    s_koi_stats.timeouts += timeout;
+    s_koi_stats.te_period_us = period;
+    if (!shared) s_koi_stats.wait_us = wait;
+    s_koi_stats.dma_us = dma;
+    if (last) {
+        s_koi_stats.frames++;
+        s_koi_window_frames++;
+        if (s_koi_previous_frame_us) {
+            uint32_t gap = (uint32_t)(now - s_koi_previous_frame_us);
+            s_koi_stats.frame_gap_us = gap;
+            if (gap > s_koi_stats.max_frame_gap_us) s_koi_stats.max_frame_gap_us = gap;
+        }
+        s_koi_previous_frame_us = now;
+        int64_t elapsed = now - s_koi_since_us;
+        if (elapsed >= 1000000) {
+            s_koi_stats.fps = (unsigned)(((int64_t)s_koi_window_frames*1000000 + elapsed/2)/elapsed);
+            s_koi_since_us = now;
+            s_koi_window_frames = 0;
+        }
+    }
+    portEXIT_CRITICAL(&s_koi_stats_lock);
+}
 
