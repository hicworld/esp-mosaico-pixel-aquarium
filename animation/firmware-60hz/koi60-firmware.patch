 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -19,6 +21,81 @@
 static int selected=-1;
 static system_update_info_t available_system_update;
 static bool has_system_update;
+
+enum { KOI_HZ=60, KOI_FRAME_US=16667, KOI_REFRESH_MS=16, KOI_DRAIN_LIMIT=3 };
+static bool koi_fast, koi_prepared;
+static int64_t koi_next_us, koi_stats_since_us;
+static uint32_t koi_frame_ms;
+static unsigned koi_presented, koi_dropped, koi_presented_hz;
+
+/* Caller holds the adapter's recursive display mutex. */
+static void koi_set_fast(bool enabled) {
+    if (koi_fast==enabled) return;
+    lv_display_t *display=bsp_display_get();
+    if (!display) return;
+    lv_timer_t *timer=lv_display_get_refr_timer(display);
+    if (!timer) return;
+    lv_timer_set_period(timer,enabled?KOI_REFRESH_MS:LV_DEF_REFR_PERIOD);
+    (void)esp_lv_adapter_fps_stats_enable(display,enabled);
+    koi_fast=enabled;
+    koi_prepared=false;
+    if (enabled) {
+        koi_next_us=koi_stats_since_us=esp_timer_get_time();
+        koi_presented=koi_dropped=koi_presented_hz=0;
+    }
+}
+
+static bool koi_try_display(void) {
+    /* Busy is expected here; avoid logging once per polling attempt. */
+    const char *tag="esp_lvgl:adapter";
+    esp_log_level_t level=esp_log_level_get(tag);
+    esp_log_level_set(tag,ESP_LOG_NONE);
+    bool locked=bsp_display_lock(0);
+    esp_log_level_set(tag,level);
+    return locked;
+}
+
+static void koi_tick(void) {
+    int64_t now_us=esp_timer_get_time();
+    if (now_us>=koi_next_us) {
+        unsigned due=(unsigned)((now_us-koi_next_us)/KOI_FRAME_US+1);
+        koi_next_us+=(int64_t)due*KOI_FRAME_US;
+        koi_dropped+=due-1+koi_prepared;
+        koi_frame_ms=(uint32_t)(now_us/1000);
+        /* Events 9/10 with b=60 are private to this app version. */
+        runtime_event(9,koi_frame_ms,KOI_HZ);
+        koi_prepared=runtime_state()==APP_RUNNING;
+    }
+    if (koi_prepared && koi_try_display()) {
+        /* Scene and image imports reenter this same recursive mutex. */
+        runtime_event(1,koi_frame_ms,KOI_HZ);
+        for (unsigned i=0;i<KOI_DRAIN_LIMIT && runtime_state()==APP_RUNNING;i++)
+            runtime_event(10,koi_frame_ms,KOI_HZ);
+        bsp_display_unlock();
+        koi_prepared=false;
+        if (runtime_state()==APP_RUNNING) koi_presented++;
+    }
+    int64_t elapsed_us=now_us-koi_stats_since_us;
+    if (elapsed_us>=1000000) {
+        koi_presented_hz=(unsigned)(((int64_t)koi_presented*1000000+elapsed_us/2)/elapsed_us);
+        koi_stats_since_us=now_us;
+        koi_presented=0;
+    }
+}
+
+unsigned launcher_poll_ms(void) { return koi_fast?1u:10u; }
+
+void launcher_koi_fps(void) {
+    uint32_t fps=0;
+    int flush_fps=-1;
+    if (koi_fast && koi_try_display()) {
+        if (esp_lv_adapter_get_fps(bsp_display_get(),&fps)==ESP_OK) flush_fps=(int)fps;
+        bsp_display_unlock();
+    }
+    printf("KOI_FPS active=%u target=%u present_hz=%u flush_fps=%d dropped=%u\n",
+           (unsigned)koi_fast,koi_fast?(unsigned)KOI_HZ:0u,koi_presented_hz,flush_fps,koi_dropped);
+}
+
 #define T(zh,en) ui_text((zh),(en))
 void launcher_post(ui_message_t msg) { if (queue) xQueueSend(queue,&msg,0); }
 static void action(lv_event_t *e) {
@@ -92,6 +169,7 @@
     return T("无效","Invalid");
 }
